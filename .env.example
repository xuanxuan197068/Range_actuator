# 复制为 .env 后填写（或在 Agent 的 mcpServers.env 里注入同名变量）

# 靶场 API 根地址（只由服务端配置，Agent 不可传）
TOPO_BASE_URL=http://172.23.215.103/api/topo

# 登录后从浏览器复制的完整 Cookie 头值（第一版认证唯一来源）
TOPO_COOKIE=在此粘贴登录后的 Cookie

# 写操作总开关。true 才允许 topo_execute_script 真正下发脚本
TOPO_ALLOW_EXECUTE=true

# 可选：逗号分隔的项目 id 或名称白名单；留空=不限制
TOPO_PROJECT_ALLOWLIST=

# 单次执行的设备数上限
TOPO_MAX_DEVICES_PER_EXEC=20

# 单个脚本字节上限
TOPO_MAX_SCRIPT_BYTES=65536

# 远端分页页大小 / 单次查询返回条数上限
TOPO_API_PAGE_SIZE=200
TOPO_MAX_ITEMS=500

# HTTP 超时秒 / 仅 GET 的重试次数
TOPO_HTTP_TIMEOUT=30
TOPO_GET_RETRIES=2

# 日志 outMsg/errMsg 截断长度
TOPO_LOG_MSG_MAXLEN=4000
